rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 인증 필수
    function isAuthenticated() {
      return request.auth != null;
    }

    // 본인 확인
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 관리자 확인
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalHttpsUrl(value) {
      return value == null || (
        value is string &&
        value.size() <= 2048 &&
        value.matches('^https://[^\\s]+$')
      );
    }

    function isOptionalEmail(value) {
      return value == null || (
        value is string &&
        value.size() <= 320 &&
        value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
      );
    }

    function isValidUserDocument(userId) {
      return request.resource.data.uid == userId &&
        isOptionalString(request.resource.data.nickname, 100) &&
        isOptionalString(request.resource.data.profileImage, 2048) &&
        isOptionalEmail(request.resource.data.email) &&
        (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'user' ||
          request.resource.data.role == 'admin'
        );
    }

    function isSafeUserSelfUpdate(userId) {
      return request.resource.data.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'stats']) &&
        isOptionalString(request.resource.data.nickname, 100) &&
        isOptionalString(request.resource.data.profileImage, 2048);
    }

    function isValidAppDocument() {
      return request.resource.data.developerId is string &&
        request.resource.data.developerNickname is string &&
        request.resource.data.developerNickname.size() <= 100 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.category in ['game', 'utility', 'productivity', 'other'] &&
        request.resource.data.testDuration is int &&
        request.resource.data.testDuration >= 7 &&
        request.resource.data.testDuration <= 30 &&
        request.resource.data.minTesters is int &&
        request.resource.data.minTesters >= 1 &&
        request.resource.data.minTesters <= 100 &&
        request.resource.data.status in ['recruiting', 'testing', 'completed', 'deleted'] &&
        isOptionalString(request.resource.data.description, 2000) &&
        isOptionalString(request.resource.data.packageName, 200) &&
        isOptionalHttpsUrl(request.resource.data.androidParticipationLink) &&
        isOptionalHttpsUrl(request.resource.data.webParticipationLink) &&
        isOptionalHttpsUrl(request.resource.data.googleGroupLink) &&
        isOptionalEmail(request.resource.data.googleGroupEmail);
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUserDocument(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if (isOwner(userId) && isSafeUserSelfUpdate(userId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Private data (Tokens, etc.) - Only accessible via Admin SDK (Cloud Functions)
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Apps
    match /apps/{appId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.developerId == request.auth.uid || isAdmin());
    }

    // Participations
    match /participations/{participationId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.testerId == request.auth.uid ||
         get(/databases/$(database)/documents/apps/$(resource.data.appId)).data.developerId == request.auth.uid);

      // Participation create is server-only (Cloud Functions callable)
      allow create: if false;

      // Restrict updates to app owner/admin only
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/apps/$(resource.data.appId)).data.developerId == request.auth.uid ||
        isAdmin()
      );

      // Tester can leave their own participation. Developers/admin can also delete.
      allow delete: if isAuthenticated() && (
        resource.data.testerId == request.auth.uid ||
        get(/databases/$(database)/documents/apps/$(resource.data.appId)).data.developerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Likes
    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    (request.resource.data.userId == request.auth.uid ||
                     request.resource.data.userId == null); // Allow if userId is null (will be set by client)
      allow update, delete: if isAuthenticated() &&
                            (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Rankings (read-only for users)
    match /rankings/{rankingId} {
      allow read: if isAuthenticated();
    }

    // Admin only
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
